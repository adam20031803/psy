<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ReclamationListController"
            style="-fx-background-color: linear-gradient(to bottom right, #1e3c72, #2a5298);">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="20"
              alignment="CENTER_RIGHT"
              style="-fx-padding: 20;
                     -fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);">

            <Label text="Réclamations"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Retour"
                    onAction="#onBack"
                    style="-fx-background-radius: 25;
                           -fx-background-color: #00c6ff;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 22;"/>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="18"
              style="-fx-padding: 30;"
              VBox.vgrow="ALWAYS">

            <!-- TABLE CARD -->
            <VBox style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20,0,0,5);"
                  VBox.vgrow="ALWAYS">

                <Label text="Liste des réclamations"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #333;"/>

                <TableView fx:id="table"
                           editable="false"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 15;
                                  -fx-border-radius: 15;
                                  -fx-table-cell-border-color: transparent;
                                  -fx-control-inner-background: white;">

                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="90"/>
                        <TableColumn fx:id="colUserId" text="User ID" prefWidth="120"/>
                        <TableColumn fx:id="colSujet" text="Sujet" prefWidth="220"/>
                        <TableColumn fx:id="colDescription" text="Description" prefWidth="360"/>
                        <TableColumn fx:id="colStatut" text="Statut" prefWidth="160"/>
                        <TableColumn fx:id="colPriorite" text="Priorité" prefWidth="160"/>
                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding: 25;">

            <!-- Optionnel : bouton secondaire en bas -->
            <Label text=""
                   style="-fx-text-fill: rgba(255,255,255,0.75);"/>
        </HBox>
    </bottom>

</BorderPane>
