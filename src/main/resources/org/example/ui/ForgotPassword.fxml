<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.ForgotPasswordController"
      spacing="15" alignment="CENTER" style="-fx-padding: 30;">

    <Label text="Mot de passe oublié" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField" promptText="Email" prefWidth="300"/>

    <Button text="Envoyer code" onAction="#onSendCode" prefWidth="300"/>

    <Hyperlink text="Retour login" onAction="#backToLogin"/>
</VBox>
