<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1200"
            prefHeight="800">

    <!-- Onglets -->
    <TabPane AnchorPane.topAnchor="0"
             AnchorPane.bottomAnchor="0"
             AnchorPane.leftAnchor="0"
             AnchorPane.rightAnchor="0">

        <!-- TAB USER -->
        <Tab text="Gérer les utilisateurs">
            <AnchorPane>
                <fx:include source="user_list.fxml"
                            AnchorPane.topAnchor="0"
                            AnchorPane.bottomAnchor="0"
                            AnchorPane.leftAnchor="0"
                            AnchorPane.rightAnchor="0"/>
            </AnchorPane>
        </Tab>

        <!-- TAB RECLAMATION -->
        <Tab text="Gérer les réclamations">
            <AnchorPane>
                <fx:include source="reclamation_list.fxml"
                            AnchorPane.topAnchor="0"
                            AnchorPane.bottomAnchor="0"
                            AnchorPane.leftAnchor="0"
                            AnchorPane.rightAnchor="0"/>
            </AnchorPane>
        </Tab>
        <Tab text="Gérer les rmotivations">
            <AnchorPane>
                <fx:include source="motivation/MainView.fxml"
                            AnchorPane.topAnchor="0"
                            AnchorPane.bottomAnchor="0"
                            AnchorPane.leftAnchor="0"
                            AnchorPane.rightAnchor="0"/>
            </AnchorPane>
        </Tab>


    </TabPane>

</AnchorPane>
