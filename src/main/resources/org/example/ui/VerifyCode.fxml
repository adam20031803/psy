<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.VerifyCodeController"
      spacing="15" alignment="CENTER" style="-fx-padding: 30;">

    <Label text="Vérifier le code" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="codeField" promptText="Code (6 chiffres)" prefWidth="300"/>

    <Button text="Vérifier" onAction="#onVerifyCode" prefWidth="300"/>

    <Hyperlink text="Retour" onAction="#backToForgot"/>
</VBox>
