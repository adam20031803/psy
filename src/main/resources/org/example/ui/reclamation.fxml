<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ReclamationController"
            style="-fx-background-color: linear-gradient(to bottom right, #1e3c72, #2a5298);">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding: 20;
                     -fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);">

            <Label text="Nouvelle réclamation"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Retour"
                    onAction="#onBack"
                    style="-fx-background-radius: 25;
                           -fx-background-color: #00c6ff;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 20;"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <StackPane style="-fx-padding: 35;">
            <VBox spacing="16"
                  maxWidth="520"
                  style="-fx-background-color: white;
                         -fx-background-radius: 22;
                         -fx-padding: 28;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 25,0,0,8);">

                <Label text="Créer une réclamation"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #333;"/>

                <!-- Sujet -->
                <VBox spacing="6">
                    <Label text="Sujet" style="-fx-text-fill: #444;"/>
                    <TextField fx:id="sujetField"
                               promptText="Ex: Problème d'accès"
                               style="-fx-background-radius: 12;
                                      -fx-padding: 10;"/>
                </VBox>

                <!-- Description -->
                <VBox spacing="6">
                    <Label text="Description" style="-fx-text-fill: #444;"/>
                    <TextArea fx:id="descriptionArea"
                              promptText="Décrivez le problème en détail..."
                              prefRowCount="6"
                              style="-fx-background-radius: 12;
                                     -fx-padding: 10;"/>
                </VBox>

                <!-- Priorité -->
                <VBox spacing="6">
                    <Label text="Priorité" style="-fx-text-fill: #444;"/>
                    <ComboBox fx:id="prioriteBox"
                              prefWidth="999"
                              style="-fx-background-radius: 12;
                                     -fx-padding: 6;"/>
                </VBox>

                <!-- Boutons -->
                <HBox spacing="12" alignment="CENTER_RIGHT">

                    <Button text="Envoyer"
                            onAction="#onSubmitReclamation"
                            style="-fx-background-radius: 25;
                                   -fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-padding: 10 22;"/>

                    <Button text="Annuler"
                            onAction="#onBack"
                            style="-fx-background-radius: 25;
                                   -fx-background-color: #e5e7eb;
                                   -fx-text-fill: #111827;
                                   -fx-font-weight: bold;
                                   -fx-padding: 10 22;"/>
                </HBox>

                <Label fx:id="messageLabel"
                       style="-fx-text-fill: #ef4444; -fx-font-weight: bold;"/>

            </VBox>
        </StackPane>
    </center>

</BorderPane>
