<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.UserController"
            style="-fx-background-color: linear-gradient(to bottom right, #1e3c72, #2a5298);">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="20" alignment="CENTER_RIGHT"
              style="-fx-padding: 20;
                     -fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);">

            <Label text="Users"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Total:"
                   style="-fx-text-fill: white; -fx-font-weight: bold;"/>
            <Label fx:id="totalUsersLabel" text="0"
                   style="-fx-text-fill: white; -fx-font-weight: bold;"/>

            <Button text="Retour" onAction="#onBack"
                    style="-fx-background-radius: 25;
                           -fx-background-color: #00c6ff;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 22;"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="14" style="-fx-padding: 30;" VBox.vgrow="ALWAYS">

            <VBox style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20,0,0,5);"
                  VBox.vgrow="ALWAYS">

                <Label text="Liste des utilisateurs"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #333;"/>

                <TableView fx:id="userTable"
                           editable="false"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-radius: 15;
                                  -fx-border-radius: 15;
                                  -fx-table-cell-border-color: transparent;
                                  -fx-control-inner-background: white;">

                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="140"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="140"/>
                        <TableColumn fx:id="colAge" text="Âge" prefWidth="70"/>
                        <TableColumn fx:id="colTel" text="Téléphone" prefWidth="130"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                        <TableColumn fx:id="colPwd" text="Mot de passe" prefWidth="150"/>
                        <TableColumn fx:id="colRole" text="Rôle" prefWidth="90"/>
                    </columns>
                </TableView>

                <!-- FORM EDIT (comme Réclamation) -->
                <Separator />

                <GridPane hgap="12" vgap="10" style="-fx-padding: 12 0 0 0;">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="15"/>
                        <ColumnConstraints percentWidth="35"/>
                        <ColumnConstraints percentWidth="15"/>
                        <ColumnConstraints percentWidth="35"/>
                    </columnConstraints>

                    <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Prénom:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                    <TextField fx:id="prenomField" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                    <Label text="Âge:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="ageField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Téléphone:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                    <TextField fx:id="telField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                    <Label text="Email:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Mot de passe:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                    <PasswordField fx:id="pwdField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                    <Label text="Rôle:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="roleBox" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
                    <Button text="Refresh" onAction="#onRefresh"
                            style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 12;"/>
                    <Button text="Update" onAction="#onUpdate"
                            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 12;"/>
                    <Button text="Delete" onAction="#onDelete"
                            style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 12;"/>
                </HBox>

                <Label fx:id="messageLabel" text=""
                       style="-fx-padding: 10 0 0 0;
                              -fx-font-weight: bold;
                              -fx-text-fill: #ef4444;"/>

            </VBox>
        </VBox>
    </center>

</BorderPane>
