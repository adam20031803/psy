<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.UserController"
            style="-fx-background-color: linear-gradient(to bottom right, #1e3c72, #2a5298);">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="20"
              alignment="CENTER_LEFT"
              style="-fx-padding: 20;
                     -fx-background-color: linear-gradient(to right, #6a11cb, #2575fc);">

            <Label text="User Management"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- LOGOUT BUTTON FIXED -->
            <Button text="Logout"
                    onAction="#logout"
                    style="-fx-background-radius: 25;
                           -fx-background-color: #00c6ff;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 8 25;"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <!-- STATS CARDS -->
            <HBox spacing="25">

                <VBox spacing="10"
                      style="-fx-background-radius: 20;
                             -fx-background-color: linear-gradient(to right, #8360c3, #2ebf91);
                             -fx-padding: 25;">
                    <Label text="TOTAL USERS"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label fx:id="totalUsersLabel"
                           text="0"
                           style="-fx-text-fill: white; -fx-font-size: 26px;"/>
                </VBox>

                <VBox spacing="10"
                      style="-fx-background-radius: 20;
                             -fx-background-color: linear-gradient(to right, #ff416c, #ff4b2b);
                             -fx-padding: 25;">
                    <Label text="ACTIVE"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="--"
                           style="-fx-text-fill: white; -fx-font-size: 26px;"/>
                </VBox>

            </HBox>

            <!-- TABLE CARD -->
            <VBox spacing="15"
                  style="-fx-background-color: white;
                         -fx-background-radius: 20;
                         -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20,0,0,5);">

                <Label text="Liste des utilisateurs"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #333;"/>

                <TableView fx:id="userTable"
                           editable="true"
                           prefHeight="500"
                           style="-fx-background-radius: 15;
                                  -fx-border-radius: 15;
                                  -fx-table-cell-border-color: transparent;
                                  -fx-control-inner-background: white;">

                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="100"/>
                        <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                        <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="200"/>
                        <TableColumn fx:id="colAge" text="Âge" prefWidth="150"/>
                        <TableColumn fx:id="colTel" text="Téléphone" prefWidth="250"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="350"/>
                        <TableColumn fx:id="colPwd" text="Mot de passe" prefWidth="250"/>
                    </columns>

                </TableView>

            </VBox>
        </VBox>
    </center>

    <!-- BOTTOM -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              spacing="20"
              style="-fx-padding: 25;">

            <Button text="Supprimer"
                    onAction="#deleteUser"
                    style="-fx-background-radius: 25;
                           -fx-background-color: #ff416c;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 10 30;"/>
        </HBox>
    </bottom>

</BorderPane>
